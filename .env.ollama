# Ollama backend — CPU or consumer GPU
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=aria-v22
BACKEND_THINK=true

# HF token — required to download:
#   1. The aria-v22 GGUF model from speri420/aria-v22 (gated; auto-approve)
#   2. (Optional) Private datasets — the public demo dataset speri420/aria-demo-data
#      does NOT need a token.
# Get a token at https://huggingface.co/settings/tokens (Read access is sufficient).
HF_TOKEN=

# GGUF filename on HF Hub (default: {OLLAMA_MODEL}-q4km.gguf, e.g. aria-v22-q4km.gguf)
# Override only if a specific version uses a different filename.
HF_GGUF_FILE=
